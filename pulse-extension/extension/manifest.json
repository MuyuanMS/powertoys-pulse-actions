{
  "manifest_version": 3,
  "name": "PowerToys Pulse Local",
  "version": "0.2.0",
  "key": "",
  "description": "Run Pulse actions locally and review their results with Codex or Copilot CLI.",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pulse local tasks"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "externally_connectable": {
    "matches": [
      "https://cautious-memory-r38ze9j.pages.github.io/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
